---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductNav from '../../../components/ProductNav.astro';
import { getLocale, localePath } from '../../../i18n/locales';
import { useT } from '../../../i18n/t';
import { getProduct, getCopy } from '../../../lib/content';
import { productLangPaths } from '../../../lib/routes';
import { graph, organization, website, webPage, breadcrumbs, videoObject, SITE } from '../../../lib/jsonld';

export const getStaticPaths = productLangPaths;

const { locale, slug, alternates } = Astro.props;
const { t } = useT(locale);
const loc = getLocale(locale);
const product = await getProduct(slug);
const copy = await getCopy(slug, locale);
const items = (await getEntry('videos', slug))?.data.items ?? [];
const path = `/${slug}/videos/`;
const url = new URL(localePath(locale, path), SITE).href;
const title = t('videos.title', { name: product.name });
const description = t('videos.description', { name: product.name });
const kinds = ['promo', 'tutorial', 'troubleshooting'] as const;
const videos = items.map((v) => ({ ...v, name: t(v.titleKey), description: t(v.descriptionKey) }));
const jsonLd = graph(
  organization(),
  website(loc.lang),
  webPage(url, title, description, loc.lang),
  breadcrumbs([
    { name: t('nav.home'), url: new URL(localePath(locale, '/'), SITE).href },
    { name: product.name, url: new URL(localePath(locale, `/${slug}/`), SITE).href },
    { name: t('labels.videos'), url },
  ]),
  ...videos.map((v) => videoObject(v)),
);
---

<Base locale={locale} path={path} title={`${title} · ${t('site.name')}`} description={description} alternates={alternates} jsonLd={jsonLd} noindex={videos.length === 0} accent={product.accent} productSlug={slug} ogImage={`/og/${slug}.png`}>
  <ProductNav locale={locale} product={product} current="videos" showVideos={videos.length > 0} />
  <section class="wrap section">
    <div class="mono mono-accent" style="margin-bottom:14px">{product.name}</div>
    <h1 class="h-page">{title}</h1>
    <p class="lede" style="margin-top:16px">{videos.length ? description : copy.tagline}</p>
  </section>

  {videos.length === 0 ? (
    <section class="wrap section">
      <h2 class="h-sub" style="margin-bottom:8px">{t('videos.emptyHeading')}</h2>
      <p class="lede" style="margin-bottom:20px">{t('videos.emptyBody')}</p>
      <div class="actions">
        <a class="link-plain" href={localePath(locale, `/${slug}/features/`)}>{t('labels.features')}</a>
        <a class="link-plain" href={localePath(locale, `/${slug}/faq/`)}>{t('labels.faq')}</a>
      </div>
    </section>
  ) : (
    kinds.map((kind) => {
      const group = videos.filter((v) => v.kind === kind);
      return group.length > 0 && (
        <section class="wrap section">
          <div class="section-head mono"><span>{t(`videos.kinds.${kind}`)}</span><span>{group.length}</span></div>
          <div class="video-grid">
            {group.map((v) => (
              <figure class="video">
                <a class="facade" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} data-yt={v.youtubeId} aria-label={`${t('videos.play')}: ${v.name}`}>
                  <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
                  <span class="play" aria-hidden="true">▶</span>
                </a>
                <figcaption>
                  <strong>{v.name}</strong>
                  <span class="mono">{v.duration.replace('PT', '').toLowerCase()}</span>
                  <p>{v.description}</p>
                  {v.feature && <a href={localePath(locale, `/${slug}/features/${v.feature}/`)}>{t('labels.features')} →</a>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      );
    })
  )}
</Base>

<script>
  // Facade: nothing from YouTube loads until the viewer clicks. Without JS the link opens YouTube.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a.facade[data-yt]')) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1`;
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = a.getAttribute('aria-label') ?? '';
      iframe.style.cssText = 'width:100%;aspect-ratio:16/9;border:0;display:block';
      a.replaceWith(iframe);
    });
  }
</script>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .video {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .facade {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--fg);
    font-size: 40px;
    background: #00000055;
  }
  figcaption {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  figcaption p {
    color: var(--fg-2);
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .video-grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }
</style>
