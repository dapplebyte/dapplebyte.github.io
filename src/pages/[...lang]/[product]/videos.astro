---
import { getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductNav from '../../../components/ProductNav.astro';
import VideoFacade from '../../../components/VideoFacade.astro';
import { getLocale, localePath } from '../../../i18n/locales';
import { useT } from '../../../i18n/t';
import { getProduct, getCopy, getFaqOrEnglish, faqEntryById, formatDuration } from '../../../lib/content';
import { productLangPaths } from '../../../lib/routes';
import { graph, organization, website, webPage, breadcrumbs, videoObject, SITE } from '../../../lib/jsonld';

export const getStaticPaths = productLangPaths;

const { locale, slug, alternates } = Astro.props;
const { t, tp } = useT(locale);
const loc = getLocale(locale);
const product = await getProduct(slug);
const copy = await getCopy(slug, locale);
const items = (await getEntry('videos', slug))?.data.items ?? [];
// The FAQ (or its English fallback) tells which section page a video's question lives on.
const faq = (await getFaqOrEnglish(slug, locale))?.faq;
const path = `/${slug}/videos/`;
const url = new URL(localePath(locale, path), SITE).href;
const title = t('videos.title', { name: product.name });
const description = tp(slug, 'videosDescription', { name: product.name });
const kinds = ['promo', 'tutorial', 'troubleshooting'] as const;
const videos = items.map((v) => {
  const q = v.faq && faq ? faqEntryById(faq, v.faq) : undefined;
  return {
    ...v,
    name: t(v.titleKey),
    description: t(v.descriptionKey),
    faqHref: q ? localePath(locale, `/${slug}/faq/${q.section.id}/`) + '#' + q.entry.id : undefined,
  };
});
const playlistUrl = product.youtubePlaylist ? `https://www.youtube.com/playlist?list=${product.youtubePlaylist}` : undefined;
const jsonLd = graph(
  organization(),
  website(loc.lang),
  webPage(url, title, description, loc.lang),
  breadcrumbs([
    { name: t('nav.home'), url: new URL(localePath(locale, '/'), SITE).href },
    { name: product.name, url: new URL(localePath(locale, `/${slug}/`), SITE).href },
    { name: t('labels.videos'), url },
  ]),
  ...videos.map((v) => videoObject(v)),
);
---

<Base locale={locale} path={path} title={`${title} · ${t('site.name')}`} description={description} alternates={alternates} jsonLd={jsonLd} noindex={videos.length === 0} accent={product.accent} productSlug={slug} ogImage={`/og/${slug}.png`}>
  <ProductNav locale={locale} product={product} current="videos" />
  <section class="wrap section">
    <div class="mono mono-accent" style="margin-bottom:14px">{product.name}</div>
    <h1 class="h-page">{title}</h1>
    <p class="lede" style="margin-top:16px">{videos.length ? description : copy.tagline}</p>
    {videos.length > 0 && (playlistUrl || product.tiktokProfile) && (
      <p class="channels" style="margin-top:16px">
        {playlistUrl && <a href={playlistUrl}>▶ {t('videos.playlist')}</a>}
        {product.tiktokProfile && <a href={product.tiktokProfile}>▶ {t('videos.tiktokProfile')}</a>}
      </p>
    )}
  </section>

  {videos.length === 0 ? (
    <section class="wrap section">
      <h2 class="h-sub" style="margin-bottom:8px">{t('videos.emptyHeading')}</h2>
      <p class="lede" style="margin-bottom:20px">{t('videos.emptyBody')}</p>
      <div class="actions">
        <a class="link-plain" href={localePath(locale, `/${slug}/features/`)}>{t('labels.features')}</a>
        <a class="link-plain" href={localePath(locale, `/${slug}/faq/`)}>{t('labels.faq')}</a>
      </div>
    </section>
  ) : (
    kinds.map((kind) => {
      const group = videos.filter((v) => v.kind === kind);
      const portrait = group.length > 0 && group.every((v) => v.aspect === '9:16');
      return group.length > 0 && (
        <section class="wrap section">
          <div class="section-head mono"><span>{t(`videos.kinds.${kind}`)}</span><span>{group.length}</span></div>
          <div class:list={['video-grid', { portrait }]}>
            {group.map((v) => (
              <figure class="video">
                <VideoFacade youtubeId={v.youtubeId} label={`${t('videos.play')}: ${v.name}`} aspect={v.aspect} />
                <figcaption>
                  <strong>{v.name}</strong>
                  <span class="mono">{formatDuration(v.duration)}</span>
                  <p>{v.description}</p>
                  <span class="links">
                    <a href={`https://www.youtube.com/watch?v=${v.youtubeId}${product.youtubePlaylist ? `&list=${product.youtubePlaylist}` : ''}`}>{t('videos.watchOn')}</a>
                    {v.tiktokId && product.tiktokProfile && <a href={`${product.tiktokProfile}/video/${v.tiktokId}`}>{t('videos.watchOnTikTok')}</a>}
                  </span>
                  {(v.feature || v.faqHref) && (
                    <span class="links">
                      {v.feature && <a href={localePath(locale, `/${slug}/features/${v.feature}/`)}>{t('labels.features')} →</a>}
                      {v.faqHref && <a href={v.faqHref}>{t('labels.faq')} →</a>}
                    </span>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      );
    })
  )}
</Base>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .video-grid.portrait {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .video {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--surface);
    display: flex;
    flex-direction: column;
  }
  figcaption {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  figcaption p {
    color: var(--fg-2);
    font-size: 15px;
  }
  .links {
    display: flex;
    gap: 6px 18px;
    flex-wrap: wrap;
  }
  .channels {
    display: flex;
    gap: 8px 24px;
    flex-wrap: wrap;
  }
  @media (max-width: 860px) {
    .video-grid,
    .video-grid.portrait {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .video-grid,
    .video-grid.portrait {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }
</style>
