---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import ProductNav from '../../../components/ProductNav.astro';
import ProductHero from '../../../components/ProductHero.astro';
import VideoFacade from '../../../components/VideoFacade.astro';
import { getLocale, localePath } from '../../../i18n/locales';
import { useT, formatDate } from '../../../i18n/t';
import { getProduct, getCopy, getFaq, faqEntryById, copySection, localesFor } from '../../../lib/content';
import { productLangPaths } from '../../../lib/routes';
import { graph, organization, website, webPage, breadcrumbs, softwareApplication, SITE } from '../../../lib/jsonld';
import { screenshots } from '../../../lib/screenshots';
import { getEntry } from 'astro:content';

export const getStaticPaths = productLangPaths;

const { locale, slug, alternates } = Astro.props;
const { t, tp } = useT(locale);
const loc = getLocale(locale);
const product = await getProduct(slug);
const copy = await getCopy(slug, locale);
const faq = await getFaq(slug, locale);
const features = (await getEntry('features', slug))?.data.items ?? [];
const videos = (await getEntry('videos', slug))?.data.items ?? [];
const path = `/${slug}/`;
const url = new URL(localePath(locale, path), SITE).href;
const shots = screenshots(slug, locale, product.screenshotCount);
const langs = (await localesFor('productCopy', slug)).map((s) => getLocale(s).lang);
const latest = product.versions.at(-1);

const portrait = product.screenshotOrientation === 'portrait';

const featureSections = features.map((f) => ({ f, s: copySection(copy, f.sectionId) })).filter((x) => x.s);
// Fixed blocks of the page, filled from the store listing sections named in products/<slug>.json `overview`.
const { overview } = product;
const useCases = overview.useCases ? copySection(copy, overview.useCases) : undefined;
const steps = overview.steps ? copySection(copy, overview.steps) : undefined;
const cells = overview.cells.map((id) => copySection(copy, id)).filter((s) => !!s);
const fine = overview.fine ? copySection(copy, overview.fine) : undefined;
const featured = faq ? product.featuredFaq.map((id) => faqEntryById(faq, id)).filter(Boolean) : [];
const intro = videos.find((v) => v.kind === 'tutorial') ?? videos[0];

const jsonLd = graph(
  organization(),
  website(loc.lang),
  webPage(url, t('product.title', { name: product.name }), copy.tagline, loc.lang, copy.extractedAt),
  breadcrumbs([
    { name: t('nav.home'), url: new URL(localePath(locale, '/'), SITE).href },
    { name: product.name, url },
  ]),
  softwareApplication(product, copy, langs, screenshots(slug, 'en', product.screenshotCount).map((i) => new URL(i.src, SITE).href), true, features.map((f) => f.sectionId)),
);
---

<Base locale={locale} path={path} title={t('product.title', { name: product.name })} description={copy.shortDescription} alternates={alternates} jsonLd={jsonLd} accent={product.accent} productSlug={slug} ogImage={`/og/${slug}.png`}>
  <ProductNav locale={locale} product={product} current="overview" />

  <section class="grid-bg">
    <div class="wrap section">
      <ProductHero locale={locale} product={product} copy={copy} level={1} />
      <div class="chips" style="margin-top:18px">
        {product.minOs && <span class="chip">{t('facts.minOs', { version: product.minOs })}</span>}
        <span class="chip">{tp(slug, 'kicker')}</span>
        {product.languages && <span class="chip">{t('facts.languages', { count: product.languages })}</span>}
        {product.sourceLicense && <span class="chip">{t('facts.source', { license: product.sourceLicense })}</span>}
        {latest && <span class="chip">{t('facts.version', { version: latest.name })}</span>}
      </div>
      {copy.requires && <p class="fine" style="margin-top:14px"><strong>{t('product.requiresLabel')}:</strong> {copy.requires}</p>}
    </div>
  </section>

  {shots.length > 0 && (
    <section class="wrap section">
      <div class="section-head mono"><span>{t('product.screenshotsHeading')}</span><span>{shots.length}</span></div>
      <div class="shots-strip">
        {shots.map((img, i) => (
          <figure>
            <Image src={img} alt={t('product.screenshotAlt', { name: product.name, index: i + 1 })} widths={img.height > img.width ? [240, 480] : [560, 1120]} sizes={img.height > img.width ? '200px' : '(max-width: 860px) 78vw, 560px'} loading={i < (portrait ? 4 : 2) ? 'eager' : 'lazy'} />
          </figure>
        ))}
      </div>
    </section>
  )}

  {useCases && (
    <section class="wrap section">
      <h2 class="h-section">{useCases.title}</h2>
      <ul class="bullets two-col">{useCases.bullets.map((b) => <li>{b}</li>)}</ul>
    </section>
  )}

  {steps && (
    <section class="wrap section">
      <h2 class="h-section">{steps.title}</h2>
      {steps.paragraphs.map((p) => <p class="muted" style="margin-top:12px">{p}</p>)}
      <ol class="steps">{steps.bullets.map((b) => <li>{b}</li>)}</ol>
    </section>
  )}

  {intro && (
    <section class="wrap section">
      <div class="section-head mono"><span>{t('product.videoHeading')}</span><a href={localePath(locale, `/${slug}/videos/`)}>{t('product.allVideos')} →</a></div>
      <div class="in-action">
        <VideoFacade youtubeId={intro.youtubeId} label={`${t('videos.play')}: ${t(intro.titleKey)}`} aspect={intro.aspect} />
        <div>
          <h2 class="h-sub" style="margin-bottom:10px">{t(intro.titleKey)}</h2>
          <p class="muted">{t(intro.descriptionKey)}</p>
        </div>
      </div>
    </section>
  )}

  <section class="wrap section">
    <div class="section-head mono"><span>{t('product.featuresHeading')}</span><a href={localePath(locale, `/${slug}/features/`)}>{t('labels.features')} →</a></div>
    <div class="cells cells-2">
      {featureSections.map(({ f, s }) => (
        <div>
          <h3 class="h-sub" style="margin-bottom:10px"><a class="feature-link" href={localePath(locale, `/${slug}/features/${f.id}/`)}>{s!.title}</a></h3>
          {s!.paragraphs.map((p) => <p class="muted">{p}</p>)}
          <ul class="bullets">{s!.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  {featured.length > 0 && faq && (
    <section class="wrap section">
      <div class="section-head mono"><span>{t('product.faqHeading')}</span><a href={localePath(locale, `/${slug}/faq/`)}>{t('product.faqAll')} →</a></div>
      <div class="featured-faq">
        {featured.map((x) => (
          <div class="featured-q">
            <h3 class="h-sub"><a href={localePath(locale, `/${slug}/faq/${x!.section.id}/`) + '#' + x!.entry.id}>{x!.entry.q}</a></h3>
            <p class="muted">{x!.entry.a[0]}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {cells.length > 0 && (
    <section class="wrap section">
      <div class={`cells cells-${Math.min(cells.length, 3)}`}>
        {cells.map((c) => (
          <div>
            <h3 class="h-sub" style="margin-bottom:10px">{c.title}</h3>
            {c.paragraphs.map((p) => <p class="muted">{p}</p>)}
            {c.bullets.length > 0 && <ul class="bullets muted">{c.bullets.map((b) => <li>{b}</li>)}</ul>}
            {c.id === overview.privacyLinkIn && <p style="margin-top:10px"><a href={localePath(locale, `/${slug}/privacy/`)}>{t('privacy.title', { name: product.name })} →</a></p>}
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="wrap section">
    <h2 class="h-section" style="margin-bottom:12px">{t('product.getHeading', { name: product.name })}</h2>
    <p class="lede" style="margin-bottom:20px">{t('product.getBody')}{product.sourceLicense && ` ${t('product.getBodySource', { license: product.sourceLicense })}`}</p>
    <div class="actions">
      {product.playUrl && <a class="button" href={product.playUrl}>{t('cta.getOnPlay', { name: product.name })}</a>}
      {product.sourceUrl && <a class="link-plain" href={product.sourceUrl}>{t('cta.readSource')}</a>}
      <a class="link-plain" href={localePath(locale, `/${slug}/support/`)}>{t('labels.support')}</a>
    </div>
    {fine && <p class="fine" style="margin-top:28px">{fine.paragraphs.join(' ')}</p>}
    <p class="fine" style="margin-top:8px">{t('labels.lastUpdated', { date: formatDate(locale, copy.extractedAt, loc.lang) })}</p>
  </section>
</Base>

<style>
  .bullets {
    margin: 0;
    padding-inline-start: 1.1em;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--fg-2);
  }
  .two-col {
    margin-top: 16px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 32px;
    max-width: 960px;
  }
  .muted {
    color: var(--fg-2);
  }
  .muted + .muted {
    margin-top: 8px;
  }
  .steps {
    margin: 16px 0 0;
    padding-inline-start: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--fg-2);
    max-width: 64ch;
  }
  .steps li::marker {
    color: var(--product);
    font-family: var(--font-mono);
  }
  .in-action {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .in-action:has(.vf-landscape) {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .feature-link {
    color: var(--fg);
    text-decoration: none;
  }
  .feature-link:hover {
    color: var(--accent);
  }
  .featured-faq {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 40px;
  }
  .featured-q h3 {
    margin-bottom: 6px;
  }
  .featured-q h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  .featured-q h3 a:hover {
    color: var(--accent);
  }
  .featured-q p {
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 860px) {
    .two-col,
    .featured-faq,
    .in-action,
    .in-action:has(.vf-landscape) {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
  }
</style>
