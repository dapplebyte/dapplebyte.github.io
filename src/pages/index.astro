---
import Base from '../layouts/Base.astro';

const relaypad = {
  name: 'Relaypad',
  tagline: 'Remote Play controller and console streaming for PS5 and PS4 on Android.',
  points: [
    'Use your phone as a wireless controller, with layouts you can edit',
    'Stream the console to your phone, tablet or TV, up to 1080p60 with HEVC and HDR',
    'Play away from home over 5G, 4G or another Wi-Fi',
  ],
  play: 'https://play.google.com/store/apps/details?id=com.relaypad.remoteplay.app',
  source: 'https://codeberg.org/geektech54/gamec',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://dapplebyte.com/#org',
      name: 'DappleByte',
      url: 'https://dapplebyte.com',
      logo: 'https://dapplebyte.com/favicon.svg',
      email: 'hello@dapplebyte.com',
      sameAs: ['https://github.com/dapplebyte'],
    },
    {
      '@type': 'SoftwareApplication',
      name: relaypad.name,
      description: relaypad.tagline,
      applicationCategory: 'GameApplication',
      operatingSystem: 'Android',
      url: relaypad.play,
      publisher: { '@id': 'https://dapplebyte.com/#org' },
    },
  ],
};
---

<Base
  title="DappleByte — Independent Android apps"
  description="DappleByte is an independent studio making Android apps, including Relaypad, a Remote Play controller and console streaming app for PS5 and PS4."
  jsonLd={jsonLd}
>
  <div class="wrap">
    <header>
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="32" height="32" />
        <span>DappleByte</span>
      </a>
    </header>

    <main>
      <section class="hero">
        <h1>Small, useful apps, made with care.</h1>
        <p>DappleByte is an independent studio building Android apps.</p>
      </section>

      <section aria-labelledby="apps">
        <h2 id="apps">Apps</h2>
        <article class="card">
          <h3>{relaypad.name}</h3>
          <p class="tagline">{relaypad.tagline}</p>
          <ul>
            {relaypad.points.map((p) => <li>{p}</li>)}
          </ul>
          <div class="actions">
            <a class="button" href={relaypad.play}>Get it on Google Play</a>
            <a href={relaypad.source}>Source code</a>
          </div>
        </article>
      </section>
    </main>

    <footer>
      <p>Contact: <a href="mailto:hello@dapplebyte.com">hello@dapplebyte.com</a></p>
      <p class="fine">
        PlayStation, PS5 and PS4 are trademarks of Sony Interactive Entertainment Inc.
        Relaypad is not affiliated with or endorsed by Sony.
      </p>
      <p class="fine">© {new Date().getFullYear()} DappleByte</p>
    </footer>
  </div>
</Base>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .hero {
    padding: 64px 0 40px;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 6vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero p {
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 24px;
  }

  .card h3 {
    margin: 0 0 4px;
    font-size: 1.4rem;
  }

  .tagline {
    margin: 0 0 12px;
    color: var(--muted);
  }

  .card ul {
    margin: 0 0 20px;
    padding-left: 1.2em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .button {
    display: inline-block;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--brand);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }

  footer {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  footer p {
    margin: 0 0 6px;
  }

  .fine {
    font-size: 0.8rem;
  }
</style>
