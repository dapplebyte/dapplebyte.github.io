---
import { Image } from 'astro:assets';
import { useT } from '../i18n/t';
import type { Product, ProductCopy } from '../lib/content';
import { screenshot, screenshots } from '../lib/screenshots';
import { productStyle } from '../lib/brand';

/**
 * Compact product card for the home page grid: one screenshot on top, name, tagline and the two
 * calls to action below. The lead product uses ProductHero instead.
 */
interface Props {
  locale: string;
  product: Product;
  copy: ProductCopy;
  linkTo: string;
  level?: 2 | 3;
}
const { locale, product, copy, linkTo, level = 2 } = Astro.props;
const { t, tp } = useT(locale);
const Heading = `h${level}` as 'h2' | 'h3';
const iconSrc = `/${product.slug}/icon.png`;
const portrait = product.screenshotOrientation === 'portrait';
// Portrait products: the first portrait screenshot, shown as a phone rising from the bottom of the frame.
// Landscape products: the hero shot, cropped to the phone screen like the product page's hero.
const phone = portrait
  ? screenshots(product.slug, locale, product.screenshotCount)
      .map((img, i) => ({ img, index: i + 1 }))
      .find((x) => x.img.height > x.img.width)
  : undefined;
const wide = portrait ? undefined : { img: screenshot(product.slug, locale, product.heroShot), index: product.heroShot };
const alt = (index: number) => t('product.screenshotAlt', { name: product.name, index });
---

<article class="card" style={productStyle(product)}>
  <a class:list={['card-media', portrait ? 'portrait' : 'landscape']} href={linkTo} tabindex="-1" aria-hidden="true">
    {phone && <Image src={phone.img} alt={alt(phone.index)} widths={[240, 480]} sizes="(max-width: 860px) 50vw, 180px" loading="lazy" />}
    {wide?.img && (
      <div class="crop">
        <Image src={wide.img} alt={alt(wide.index)} widths={[480, 960]} sizes="(max-width: 860px) 90vw, 320px" loading="lazy" />
      </div>
    )}
  </a>
  <div class="card-copy">
    <div class="card-id">
      <img src={iconSrc} alt="" width="44" height="44" class="card-icon" />
      <div>
        <Heading class="display card-name"><a href={linkTo}>{product.name}</a></Heading>
        <div class="mono card-kicker">{product.platform} · {tp(product.slug, 'kicker')}</div>
      </div>
    </div>
    <p class="card-tagline">{copy.tagline}</p>
    <div class="actions card-actions">
      {product.playUrl && <a class="button" href={product.playUrl}>{t('cta.getOnPlay', { name: product.name })}</a>}
      <a class="link-plain" href={linkTo}>{t('cta.about', { name: product.name })} →</a>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--surface);
    min-width: 0;
  }
  /* A fixed 4:3 window onto the product, lit from below in the product's own colour. */
  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(70% 60% at 50% 108%, color-mix(in srgb, var(--product-solid) 26%, transparent), transparent 70%),
      var(--bg-deep);
  }
  .card-media.portrait img {
    position: absolute;
    left: 50%;
    top: 9%;
    width: 50%;
    max-width: none;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    object-position: top;
    transform: translateX(-50%);
    border: 1px solid var(--line-2);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
    background: var(--bg);
    box-shadow: 0 -8px 40px color-mix(in srgb, var(--product-solid) 18%, transparent);
  }
  .card-media.landscape .crop {
    position: absolute;
    inset-inline: 4.5%;
    top: 50%;
    transform: translateY(-50%);
    box-shadow: 0 10px 40px color-mix(in srgb, var(--product-solid) 18%, transparent);
  }
  .card-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
    padding: clamp(18px, 2.4vw, 24px);
  }
  .card-id {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: block;
    flex: 0 0 auto;
  }
  .card-name {
    font-size: 22px;
    line-height: 1.1;
  }
  .card-name a {
    color: var(--fg);
    text-decoration: none;
  }
  .card-kicker {
    margin-top: 2px;
    font-size: 12px;
  }
  .card-tagline {
    font-size: 16px;
    line-height: 1.5;
    color: var(--fg-2);
  }
  .card-actions {
    margin-top: auto;
    padding-top: 6px;
    gap: 12px 16px;
  }
  .card-actions .button {
    font-size: 14px;
    padding: 11px 16px;
  }
  .card-actions .link-plain {
    font-size: 15px;
  }
</style>
