---
import { useT } from '../i18n/t';
import type { Product } from '../lib/content';

/**
 * The Google Play call to action. A live product that has no store listing yet gets a "Coming soon to Google Play"
 * label instead: plain text in the button's place, not a link.
 */
interface Props {
  locale: string;
  product: Product;
}
const { locale, product } = Astro.props;
const { t } = useT(locale);

// Tag the store link so Play Console's acquisition report can tell website traffic apart from
// in-app cross-promotion and other referrers. The referrer value is itself URL-encoded.
const referrer = encodeURIComponent('utm_source=dapplebyte&utm_medium=web&utm_campaign=product_page');
const playHref = product.playUrl ? `${product.playUrl}&referrer=${referrer}` : undefined;
---

{playHref ? (
  <a class="button" href={playHref}>{t('cta.getOnPlay', { name: product.name })}</a>
) : (
  product.status === 'live' && <span class="soon">{t('cta.comingSoon')}</span>
)}
