---
import { Image } from 'astro:assets';
import { useT } from '../i18n/t';
import type { Product, ProductCopy } from '../lib/content';
import { screenshot, screenshots } from '../lib/screenshots';
import { productStyle } from '../lib/brand';

interface Props {
  locale: string;
  product: Product;
  copy: ProductCopy;
  /** Name is rendered as <h1> on the product page and <h2>/<h3> elsewhere. */
  level?: 1 | 2 | 3;
  /** Link the name and add "About" instead of showing it as the current page. */
  linkTo?: string;
  kicker?: string;
  /** Landscape products: which screenshot fills the wide frame. */
  shot?: number;
  /** The home page's lead product: bigger name, more screenshots. */
  featured?: boolean;
}
const { locale, product, copy, level = 1, linkTo, kicker, shot = product.heroShot, featured = false } = Astro.props;
const { t, tp, listp } = useT(locale);
const Heading = `h${level}` as 'h1' | 'h2' | 'h3';
const iconSrc = `/${product.slug}/icon.png`;
const points = listp<string>(product.slug, 'heroPoints');
const portrait = product.screenshotOrientation === 'portrait';
const eager = level === 1 || featured;
// Portrait products show several phone screenshots side by side. Only portrait images are used, so a
// stray landscape screenshot in the set doesn't end up cropped to a sliver.
const phoneShots = portrait
  ? screenshots(product.slug, locale, product.screenshotCount)
      .map((img, i) => ({ img, index: i + 1 }))
      .filter((x) => x.img.height > x.img.width)
      .slice(0, featured ? 3 : 2)
  : [];
const img = portrait ? undefined : screenshot(product.slug, locale, shot);
// On the home page the tile carries its own product's colours and display face.
const style = linkTo ? productStyle(product) : undefined;
---

<article class:list={['hero-tile', { featured, portrait }]} style={style}>
  <div class="hero-copy">
    <div class="hero-id">
      <img src={iconSrc} alt="" width={featured ? 72 : 52} height={featured ? 72 : 52} class="hero-icon" />
      <div>
        <Heading class="display hero-name">
          {linkTo ? <a href={linkTo}>{product.name}</a> : product.name}
        </Heading>
        <div class="mono">{kicker ?? `${product.platform} · ${tp(product.slug, 'kicker')}`}</div>
      </div>
    </div>
    <p class="hero-tagline">{copy.tagline}</p>
    {points.length > 0 && (
      <ul class="hero-points">
        {points.map((b) => <li>{b}</li>)}
      </ul>
    )}
    <div class="actions">
      {product.playUrl && <a class="button" href={product.playUrl}>{t('cta.getOnPlay', { name: product.name })}</a>}
      {linkTo ? (
        <a class="link-plain" href={linkTo}>{t('cta.about', { name: product.name })} →</a>
      ) : (
        product.sourceUrl && <a class="link-plain" href={product.sourceUrl}>{t('cta.readSource')}</a>
      )}
    </div>
  </div>
  <div class="hero-media">
    {portrait ? (
      <div class="phones" style={`--count:${phoneShots.length}`}>
        {phoneShots.map((x) => (
          <Image src={x.img} alt={t('product.screenshotAlt', { name: product.name, index: x.index })} widths={[240, 480]} sizes="(max-width: 860px) 33vw, 240px" loading={eager ? 'eager' : 'lazy'} />
        ))}
      </div>
    ) : (
      <div class="crop">
        {img && <Image src={img} alt={t('product.screenshotAlt', { name: product.name, index: shot })} widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 640px" loading={eager ? 'eager' : 'lazy'} />}
      </div>
    )}
  </div>
</article>

<style>
  .hero-tile {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .hero-copy {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(22px, 3vw, 36px);
    border-inline-end: 1px solid var(--line);
  }
  .hero-media {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--bg-deep);
  }
  .hero-media .crop {
    margin: clamp(16px, 2.4vw, 28px);
  }
  /* Portrait screenshots side by side, each at its own 9:16 shape. When the frame would get taller than
     --phones-h, the image keeps its width and loses its bottom (the top carries the caption). */
  .phones {
    --phones-h: clamp(260px, 32vw, 420px);
    --gap: 12px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: var(--gap);
    padding: clamp(16px, 2.4vw, 28px);
  }
  .phones img {
    display: block;
    flex: 0 0 auto;
    width: calc((100% - (var(--count) - 1) * var(--gap)) / var(--count));
    max-width: none;
    height: auto;
    aspect-ratio: 9 / 16;
    max-height: var(--phones-h);
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
  }
  .hero-id {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hero-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: block;
  }
  .hero-name {
    font-size: 28px;
    line-height: 1.1;
  }
  .hero-name a {
    color: var(--fg);
    text-decoration: none;
  }
  .hero-tagline {
    font-size: 18px;
    line-height: 1.45;
    font-weight: 500;
  }
  .hero-points {
    margin: 0;
    padding-inline-start: 1.1em;
    color: var(--fg-2);
    font-size: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Featured: the home page's lead product. */
  .featured {
    border-color: var(--line-2);
  }
  .featured .hero-copy {
    gap: 22px;
    justify-content: center;
  }
  .featured .hero-icon {
    width: 72px;
    height: 72px;
    border-radius: 16px;
  }
  .featured .hero-name {
    font-size: clamp(34px, 4.4vw, 52px);
    line-height: 1.02;
  }
  .featured .hero-tagline {
    font-size: clamp(18px, 1.8vw, 21px);
  }
  .featured .phones {
    --phones-h: clamp(300px, 38vw, 480px);
  }

  @media (max-width: 860px) {
    .hero-copy,
    .hero-media {
      grid-column: span 12;
    }
    .hero-copy {
      border-inline-end: 0;
      border-bottom: 1px solid var(--line);
    }
    .phones,
    .featured .phones {
      --phones-h: clamp(240px, 70vw, 380px);
    }
  }
</style>
