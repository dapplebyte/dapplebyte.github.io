---
// A YouTube video that loads nothing from YouTube until the viewer clicks. Without JS the link opens YouTube.
interface Props {
  youtubeId: string;
  /** Accessible name, e.g. "Play video: <title>". */
  label: string;
  aspect?: '16:9' | '9:16';
  loading?: 'lazy' | 'eager';
}
const { youtubeId, label, aspect = '16:9', loading = 'lazy' } = Astro.props;
---

<div class:list={['vf', aspect === '9:16' ? 'vf-portrait' : 'vf-landscape']}>
  <a class="facade" href={`https://www.youtube.com/watch?v=${youtubeId}`} data-yt={youtubeId} aria-label={label}>
    <img src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`} alt="" width="480" height="360" loading={loading} />
    <span class="play" aria-hidden="true">▶</span>
  </a>
</div>

<script>
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a.facade[data-yt]')) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1`;
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = a.getAttribute('aria-label') ?? '';
      iframe.style.cssText = 'width:100%;height:100%;border:0;display:block';
      a.replaceWith(iframe);
    });
  }
</script>

<style>
  .vf {
    position: relative;
    overflow: hidden;
    background: var(--bg-deep);
  }
  .vf-landscape {
    aspect-ratio: 16 / 9;
  }
  /* Portrait (Shorts-style) videos: a phone-shaped frame, never taller than 640 px. */
  .vf-portrait {
    aspect-ratio: 9 / 16;
    width: min(100%, 360px);
    margin-inline: auto;
  }
  .facade {
    position: absolute;
    inset: 0;
    display: block;
  }
  .facade img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
  }
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--fg);
    font-size: 40px;
    background: #00000055;
  }
  .facade:hover .play {
    background: #00000033;
  }
</style>
