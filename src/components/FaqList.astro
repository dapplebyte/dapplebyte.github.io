---
interface Props {
  entries: { id: string; q: string; a: string[]; video?: string; tiktok?: string }[];
  /** Heading level for questions. */
  level?: 2 | 3;
  linkLabel?: string;
  /** Label of the link shown under answers that have a video. */
  watchLabel?: string;
  /** YouTube playlist the video links open in. */
  playlist?: string;
  /** Label and profile URL for the TikTok link. */
  tiktokLabel?: string;
  tiktokProfile?: string;
}
const { entries, level = 2, linkLabel = '#', watchLabel = 'YouTube', playlist, tiktokLabel = 'TikTok', tiktokProfile } = Astro.props;
const watchUrl = (id: string) => `https://www.youtube.com/watch?v=${id}${playlist ? `&list=${playlist}` : ''}`;
const H = `h${level}` as 'h2' | 'h3';
---

<div class="faq-list">
  {entries.map((e) => (
    <article class="faq-item" id={e.id}>
      <H class="faq-q">
        {e.q}
        <a class="faq-anchor" href={`#${e.id}`} aria-label={linkLabel}>#</a>
      </H>
      <div class="faq-a">
        {e.a.map((p) => <p>{p}</p>)}
        {(e.video || (e.tiktok && tiktokProfile)) && (
          <p class="faq-video">
            {e.video && <a href={watchUrl(e.video)}>▶ {watchLabel}</a>}
            {e.tiktok && tiktokProfile && <a href={`${tiktokProfile}/video/${e.tiktok}`}>▶ {tiktokLabel}</a>}
          </p>
        )}
      </div>
    </article>
  ))}
</div>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
  }
  .faq-item {
    padding-block: 26px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 24px;
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .faq-q {
    font-size: 20px;
    margin-bottom: 10px;
    max-width: 60ch;
  }
  .faq-anchor {
    color: var(--line-2);
    text-decoration: none;
    margin-inline-start: 8px;
    font-weight: 400;
  }
  .faq-item:hover .faq-anchor,
  .faq-anchor:focus {
    color: var(--accent);
  }
  .faq-a {
    max-width: 68ch;
    color: var(--fg-2);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .faq-video {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .faq-video a {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }
</style>
